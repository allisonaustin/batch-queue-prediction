    "runtime": "time\\(\\) - jobcurrentstartdate > job_expected_max_lifetime|run time/limit",
    "auth": "credentials are not available|errno 13\\b|permission denied",
    "cpu": "requested cpus",
    "transfer": "transfer output files failure|sending files to access point",
    "memory": "memory/limit|memory limit|oom|out of memory",
    "disk": "disk/limit|errno 28\\b|no space left",
    "i/o": "i/o usage|errno 5\\b|input/output error",
    "admin": "held by admin",
    "error": "errno \\d+|error code \\d+",
    "file_system": "errno 2\\b|no such file|directory|reading from file",
